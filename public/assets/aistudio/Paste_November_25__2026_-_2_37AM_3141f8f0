function updateSubCatSelect(catName) {
  const cat = state.categories.find(c => c.name === catName);
  document.getElementById('epSubCat').innerHTML = (cat?.subCats || []).map(sc => `<option>${sc}</option>`).join('');
}

function saveProduct(id) {
  const imgs = [document.getElementById('epImg1').value, document.getElementById('epImg2').value].filter(Boolean);
  if (!imgs.length) return showToast('Add at least 1 image');

  const newP = {
    id: id || Date.now(),
    name: document.getElementById('epName').value,
    price: Number(document.getElementById('epPrice').value),
    category: document.getElementById('epCat').value,
    subCat: document.getElementById('epSubCat').value,
    desc: document.getElementById('epDesc').value,
    images: imgs,
    featured: document.getElementById('epFeatured').value === 'true',
    tag: 'New', rating: 4.8
  };

  if (id) state.products[state.products.findIndex(x => x.id === id)] = newP;
  else state.products.unshift(newP);

  saveData(); renderProducts(); switchAdminTab('products');
  showToast('Product saved!');
}

function deleteProduct(id) { state.products = state.products.filter(p => p.id !== id); saveData(); renderProducts(); switchAdminTab('products'); }
function toggleFeatured(id) { const p = state.products.find(x => x.id === id); p.featured = !p.featured; saveData(); renderProducts(); switchAdminTab('products'); }
function addCategory() {
  const name = document.getElementById('newCatName').value;
  const img = document.getElementById('newCatImg').value;
  if (name && img) { state.categories.push({ name, img, subCats: [] }); saveData(); renderCategories(); renderNavLinks(); switchAdminTab('categories'); }
}
function addSubCategory() {
  const parent = document.getElementById('subCatParent').value;
  const sub = document.getElementById('newSubCatName').value;
  const cat = state.categories.find(c => c.name === parent);
  if (cat && sub) { cat.subCats.push(sub); saveData(); switchAdminTab('categories'); }
}
function deleteCategory(i) { state.categories.splice(i, 1); saveData(); renderCategories(); renderNavLinks(); switchAdminTab('categories'); }
function uploadLogo(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => { state.settings.brandIconUrl = ev.target.result; applyTheme(); };
  reader.readAsDataURL(file);
}
function saveBranding() {
  state.settings.brandName = document.getElementById('setBrand').value;
  state.settings.announcement = document.getElementById('setAnnounce').value;
  state.settings.primary = document.getElementById('setPrimary').value;
  state.settings.accent = document.getElementById('setAccent').value;
  state.settings.font = document.getElementById('setFont').value;
  state.settings.headFont = document.getElementById('setHeadFont').value;
  saveData(); applyTheme(); showToast('Branding saved!');
}
function resetTheme() {
  state.settings.primary = '#315b45';
  state.settings.accent = '#d98b55';
  state.settings.font = "'Inter', sans-serif";
  state.settings.headFont = "'Playfair Display', serif";
  saveData(); applyTheme(); showToast('Theme reset!');
}
