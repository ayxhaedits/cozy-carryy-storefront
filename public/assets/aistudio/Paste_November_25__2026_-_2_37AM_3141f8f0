function editProduct(id) {
  const p = id ? state.products.find(x => x.id === id) : null;
  document.getElementById('adminContent').innerHTML = `
    <h3>${id ? 'Edit' : 'Add'} Product</h3>
    <div class="form-row">
      <div class="form-group"><label>Name</label><input type="text" id="epName" class="form-control" value="${p ? p.name : ''}"></div>
      <div class="form-group"><label>Price</label><input type="number" id="epPrice" class="form-control" value="${p ? p.price : ''}"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Category</label><select id="epCat" class="form-control" onchange="updateSubCatSelect(this.value)">${state.categories.map(c => `<option ${p && p.category === c.name ? 'selected' : ''}>${c.name}</option>`).join('')}</select></div>
      <div class="form-group"><label>Sub Category</label><select id="epSubCat" class="form-control">${(state.categories.find(c => c.name === (p ? p.category : state.categories[0].name))?.subCats || []).map(sc => `<option ${p && p.subCat === sc ? 'selected' : ''}>${sc}</option>`).join('')}</select></div>
    </div>
    <div class="form-group"><label>Description</label><textarea id="epDesc" class="form-control">${p ? p.desc : ''}</textarea></div>
    <div class="form-group"><label>Image URLs (1-4)</label>
      <input type="url" id="epImg1" class="form-control" placeholder="Image 1" value="${p ? (p.coverImage || p.images[0]) : ''}" style="margin-bottom:5px;">
      <input type="url" id="epImg2" class="form-control" placeholder="Image 2" value="${p && p.images[1] ? p.images[1] : ''}">
    </div>
    <div class="form-group"><label>Featured?</label><select id="epFeatured" class="form-control"><option value="false" ${p && !p.featured ? 'selected' : ''}>No</option><option value="true" ${p && p.featured ? 'selected' : ''}>Yes</option></select></div>
    <button class="admin-btn" onclick="saveProduct(${id})">Save</button>
  `;
