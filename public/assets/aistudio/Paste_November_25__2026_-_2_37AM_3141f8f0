<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#111827">
<title>Premium Store — Everyday Finds</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<!-- HEADER -->
<div class="top-bar">
  <span id="topBarText">✨ Welcome to our premium store — Free delivery on orders over Rs. 5,000. Shop now! ✨</span>
</div>
<header class="header-main" id="mainHeader">
  <div class="wrap">
    <div class="header-top">
      <a href="#" class="brand-logo" onclick="setCategory('All')">
        <div class="brand-icon" id="brandIcon">C</div>
        <div class="brand-name" id="brandName">Store Name</div>
      </a>
      <div class="search-bar">
        <input type="text" id="searchInput" placeholder="Search for products, brands and more..." oninput="searchProducts()">
      </div>
      <div class="header-icons">
        <button class="icon-btn" onclick="openAuthModal()">
          <span>👤</span>
          <span>Account</span>
        </button>
        <button class="icon-btn" onclick="openCartDrawer()">
          <span>🛒</span>
          <span>Cart</span>
          <span class="badge" id="cartCount">0</span>
        </button>
      </div>
    </div>
    <nav class="nav-bar">
      <div class="nav-inner" id="navLinks"></div>
    </nav>
  </div>
</header>

<!-- HERO SLIDER -->
<section class="hero-section">
  <div class="hero-slider" id="heroSlider"></div>
  <div class="hero-nav" id="heroDots"></div>
</section>

<!-- CIRCLE CATEGORIES -->
<section class="circle-categories">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>Shop by Category</h2>
      <p>Explore our top categories curated just for you</p>
    </div>
  </div>
  <div class="circle-slider-wrapper">
    <div class="circle-slider" id="circleSlider"></div>
  </div>
</section>

<!-- PRODUCT CATALOG -->
<section class="catalog-section" id="shopSection">
  <div class="wrap">
    <div class="section-head reveal" style="text-align: left; margin-bottom: 30px;">
      <h2 style="font-size: 32px;" id="catalogTitle">Our Collection</h2>
    </div>
    <div class="filters-bar reveal">
      <div class="filter-btns" id="filterBtns">
        <button class="filter-btn active" onclick="setFilter('All')">All Products</button>
        <button class="filter-btn" onclick="setFilter('New')">New Arrivals</button>
        <button class="filter-btn" onclick="setFilter('Bestseller')">Best Sellers</button>
        <button class="filter-btn" onclick="toggleFeaturedFilter()">⭐ Featured</button>
      </div>
      <select class="sort-select" id="sortSelect" onchange="renderProducts()">
        <option value="featured">Featured</option>
        <option value="low-high">Price: Low to High</option>
        <option value="high-low">Price: High to Low</option>
      </select>
    </div>
    <div id="subcatFilter" style="margin-bottom:20px; display:none;"></div>
    <div class="product-grid" id="productGrid"></div>
  </div>
</section>

<!-- CART DRAWER -->
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-header">
    <h3>Your Cart</h3>
    <button onclick="closeCartDrawer()" style="font-size: 24px;">×</button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="cart-footer">
    <div class="cart-total"><span>Total:</span><span id="cartTotal">Rs. 0</span></div>
    <button class="checkout-btn" onclick="openCheckoutModal()">Proceed to Checkout</button>
  </div>
</div>

<!-- AUTH MODAL -->
<div class="auth-modal" id="authModal">
  <div class="auth-box">
    <button class="auth-close" onclick="closeAuthModal()">×</button>
    <h2 style="font-family:var(--font-head);text-align:center;margin-bottom:20px;" id="authTitle">Welcome Back</h2>
    <div class="auth-tabs">
      <button class="auth-tab active" id="tabLogin" onclick="switchAuthTab('login')">Login</button>
      <button class="auth-tab" id="tabSignup" onclick="switchAuthTab('signup')">Register</button>
    </div>

    <!-- Login Form -->
    <form class="auth-form active" id="formLogin" onsubmit="handleCustomerLogin(event)">
      <div class="input-group"><span>✉️</span><input type="email" id="loginEmail" placeholder="Email ID" required></div>
      <div class="input-group"><span>🔒</span><input type="password" id="loginPass" placeholder="Password" required></div>
      <button type="submit" class="auth-btn">Login</button>
      <div class="auth-footer">
        <a href="#" onclick="switchAuthTab('signup')">Don't have an account? Sign up</a><br><br>
        <a href="#" onclick="showAdminLogin()" style="color:var(--accent);font-weight:bold;">Admin Login</a>
      </div>
    </form>

    <!-- Signup Form -->
    <form class="auth-form" id="formSignup" onsubmit="handleCustomerSignup(event)">
      <div class="input-group"><span>👤</span><input type="text" id="regName" placeholder="Full Name" required></div>
      <div class="input-group"><span>✉️</span><input type="email" id="regEmail" placeholder="Email ID" required></div>
      <div class="input-group"><span>🔒</span><input type="password" id="regPass" placeholder="Password" required></div>
      <div class="input-group"><span>📞</span><input type="tel" id="regPhone" placeholder="Phone Number" required></div>
      <button type="submit" class="auth-btn">Register</button>
    </form>
  </div>
</div>

<!-- CHECKOUT MODAL -->
<div class="checkout-modal" id="checkoutModal">
  <div class="checkout-box">
    <button style="float:right;font-size:24px;" onclick="closeCheckoutModal()">×</button>
    <h2>Checkout</h2>
    <form onsubmit="placeOrder(event)">
      <div class="form-group"><label>Full Name</label><input type="text" id="coName" required></div>
      <div class="form-group"><label>Phone Number</label><input type="tel" id="coPhone" required></div>
      <div class="form-group"><label>Delivery Address</label><textarea id="coAddress" rows="2" required></textarea></div>
      <div class="form-group"><label>City</label><input type="text" id="coCity" required></div>
      <div class="form-group"><label>Notes (Optional)</label><input type="text" id="coNotes"></div>
      <button type="submit">Place Order via WhatsApp</button>
    </form>
  </div>
</div>

<!-- ADMIN PANEL -->
<div class="admin-overlay" id="adminOverlay" onclick="closeAdminPanel()"></div>
<div class="admin-panel" id="adminPanel">
  <div class="admin-header">
    <h2 id="adminTitle">Admin Login</h2>
    <button onclick="closeAdminPanel()" style="font-size: 24px;">×</button>
  </div>

  <div id="adminLoginForm" style="padding: 50px; max-width: 400px; margin: auto; width: 100%;">
    <div class="form-group"><label>Username</label><input type="text" id="adminUser" class="form-control" value="admin"></div>
    <div class="form-group"><label>Password</label><input type="password" id="adminPass" class="form-control" value="admin123"></div>
    <button class="admin-btn" style="width: 100%;" onclick="loginAdmin()">Login</button>
  </div>

  <div id="adminDashboard" style="display: none; flex-direction: column; height: 100%;">
    <div class="admin-tabs" id="adminTabs">
      <div class="admin-tab active" onclick="switchAdminTab('overview')">Overview</div>
      <div class="admin-tab active" onclick="switchAdminTab('products')">Products</div>
      <div class="admin-tab" onclick="switchAdminTab('categories')">Categories</div>
      <div class="admin-tab" onclick="switchAdminTab('branding')">Branding</div>
      <div class="admin-tab" onclick="switchAdminTab('settings')">Settings</div>
      <div class="admin-tab" onclick="switchAdminTab('orders')">Orders</div>
      <div class="admin-tab" onclick="switchAdminTab('customers')">Customers</div>
    </div>
    <div class="admin-content" id="adminContent"></div>
  </div>
</div>

<!-- PRODUCT MODAL (For details) -->
<div class="auth-modal" id="productModal">
  <div class="auth-box" style="width: min(900px, 100%); padding:0;">
    <button class="auth-close" onclick="closeProductModal()" style="z-index:10;">×</button>
    <div class="detail-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
      <div style="padding:20px; background:#f8fafc; border-radius:24px 0 0 24px; display:flex; align-items:center; justify-content:center;">
        <img id="modalMainImg" src="" style="width:100%; border-radius:12px;">
      </div>
      <div style="padding:40px 20px;">
        <div style="color:var(--text-muted);font-size:12px;text-transform:uppercase;font-weight:600;margin-bottom:10px;" id="modalCat"></div>
        <h2 style="font-family:var(--font-head);font-size:28px;margin-bottom:15px;" id="modalTitle"></h2>
        <div style="font-size:24px;font-weight:700;color:var(--accent);margin-bottom:20px;" id="modalPrice"></div>
        <p style="color:var(--text-muted);line-height:1.6;margin-bottom:20px;" id="modalDesc"></p>
        <div style="display:flex;gap:15px;">
          <button class="btn-add" style="padding:15px;" onclick="addFromModal()">Add to Cart</button>
          <button class="btn-buy" style="padding:15px;" onclick="buyFromModal()">Buy Now</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast">Action successful!</div>

<script>
/* ==========================================
   STATE & DEFAULT DATA
   ========================================== */
const defaultState = {
  products: [],
  categories: [],
  heroSlides: [],
  cart: [],
  orders: [],
  customers: [],
  settings: {
    brandName: 'CozyCaryy',
    brandIcon: 'C',
    brandIconUrl: '',
    primary: '#315b45',
    accent: '#d98b55',
    font: "'Inter', sans-serif",
    headFont: "'Playfair Display', serif",
    announcement: '✨ Welcome to our premium store — Free delivery on orders over Rs. 5,000. Shop now! ✨',
    whatsapp: '923001234567'
  }
};

// Seed Data
const seedCategories = [
  { name: 'Electronics', img: 'https://images.unsplash.com/photo-1498049794561-7780e7231661?w=200&auto=format&fit=crop', subCats: ['Mobiles', 'Laptops', 'Headphones'] },
  { name: 'Fashion', img: 'https://images.unsplash.com/photo-1445205170230-053b83016050?w=200&auto=format&fit=crop', subCats: ['Men', 'Women', 'Kids'] }
];

const seedProducts = [
  { id: 1, name: 'Wireless Headphones', category: 'Electronics', subCat: 'Headphones', price: 12999, oldPrice: 15999, rating: 4.8, tag: 'Bestseller', featured: true, images: ['https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop'], desc: 'Premium wireless headphones.' },
  { id: 2, name: 'Smart Watch', category: 'Electronics', subCat: 'Mobiles', price: 8999, oldPrice: 11999, rating: 4.9, tag: 'New', featured: true, images: ['https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop'], desc: 'Track your fitness.' }
];

const seedHero = [
  { img: 'https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?q=80&w=2070&auto=format&fit=crop', title: 'Big Winter Sale', desc: 'Up to 50% off.', btn: 'Shop Now' }
];

/* ==========================================
   INITIALIZATION
   ========================================== */
let state = {};
function loadData() {
  state = JSON.parse(localStorage.getItem('storeData')) || defaultState;
  if (!state.products || state.products.length === 0) state.products = seedProducts;
  if (!state.categories || state.categories.length === 0) state.categories = seedCategories;
  if (!state.heroSlides || state.heroSlides.length === 0) state.heroSlides = seedHero;

  applyTheme();
  renderHero();
  renderCategories();
  renderNavLinks();
  renderProducts();
  updateCartCount();

  setInterval(autoSlide, 5000);
}

function saveData() {
  localStorage.setItem('storeData', JSON.stringify(state));
}

/* ==========================================
   THEME & HEADER
   ========================================== */
function applyTheme() {
  document.documentElement.style.setProperty('--primary', state.settings.primary);
  document.documentElement.style.setProperty('--accent', state.settings.accent);
  document.documentElement.style.setProperty('--font-body', state.settings.font);
  document.documentElement.style.setProperty('--font-head', state.settings.headFont);

  document.getElementById('brandName').textContent = state.settings.brandName;
  document.getElementById('topBarText').textContent = state.settings.announcement;

  const iconEl = document.getElementById('brandIcon');
  if (state.settings.brandIconUrl) {
    iconEl.innerHTML = `<img src="${state.settings.brandIconUrl}" alt="Logo">`;
    iconEl.style.background = 'transparent';
  } else {
    iconEl.textContent = state.settings.brandIcon;
    iconEl.style.background = 'var(--primary)';
  }
}

/* ==========================================
   RENDER STORE
   ========================================== */
let slideIndex = 0;
function renderHero() {
  document.getElementById('heroSlider').innerHTML = state.heroSlides.map(s => `
    <div class="hero-slide">
      <img src="${s.img}">
      <div class="hero-content"><h1>${s.title}</h1><p>${s.desc}</p><a class="hero-btn">${s.btn}</a></div>
    </div>
  `).join('');
  document.getElementById('heroDots').innerHTML = state.heroSlides.map((_, i) => 
    `<div class="hero-dot ${i===0?'active':''}" onclick="goToSlide(${i})"></div>`
  ).join('');
  goToSlide(0);
}
function goToSlide(i) {
  slideIndex = i;
  document.getElementById('heroSlider').style.transform = `translateX(-${i * 100}%)`;
  document.querySelectorAll('.hero-dot').forEach((d, idx) => d.classList.toggle('active', idx === i));
}
function autoSlide() { goToSlide((slideIndex + 1) % state.heroSlides.length); }

function renderCategories() {
  const html = state.categories.map(c => `
    <div class="circle-cat" onclick="setCategory('${c.name}')">
      <div class="circle-img"><img src="${c.img}"></div>
      <span>${c.name}</span>
    </div>
  `).join('');
  document.getElementById('circleSlider').innerHTML = html + html;
}

function renderNavLinks() {
  document.getElementById('navLinks').innerHTML = `<a class="nav-link active" onclick="setCategory('All')">Home</a>` + 
    state.categories.map(c => `<a class="nav-link" onclick="setCategory('${c.name}')">${c.name}</a>`).join('');
}

let currentCategory = 'All';
let currentSubCat = 'All';
let currentFilter = 'All';
let featuredOnly = false;
let searchQuery = '';

function setCategory(cat) {
  currentCategory = cat;
  currentSubCat = 'All';
  searchQuery = '';
  document.getElementById('searchInput').value = '';

  document.querySelectorAll('.nav-link').forEach(l => l.classList.toggle('active', l.textContent === (cat === 'All' ? 'Home' : cat)));

  const subContainer = document.getElementById('subcatFilter');
  if (cat !== 'All') {
    const catObj = state.categories.find(c => c.name === cat);
    if (catObj && catObj.subCats.length) {
      subContainer.style.display = 'block';
      subContainer.innerHTML = `<button class="filter-btn active" onclick="setSubCat('All')">All</button>` +
        catObj.subCats.map(sc => `<button class="filter-btn" onclick="setSubCat('${sc}')">${sc}</button>`).join('');
    } else subContainer.style.display = 'none';
  } else subContainer.style.display = 'none';

  renderProducts();
  document.getElementById('shopSection').scrollIntoView({ behavior: 'smooth' });
}

function setSubCat(sc) {
  currentSubCat = sc;
  document.querySelectorAll('#subcatFilter .filter-btn').forEach(btn => btn.classList.toggle('active', btn.textContent === sc || (sc === 'All' && btn.textContent === 'All')));
  renderProducts();
}

function setFilter(f) {
  currentFilter = f;
  document.querySelectorAll('#filterBtns .filter-btn').forEach(btn => btn.classList.toggle('active', btn.textContent.includes(f)));
  renderProducts();
}

function toggleFeaturedFilter() {
  featuredOnly = !featuredOnly;
  document.querySelectorAll('#filterBtns .filter-btn').forEach(btn => btn.classList.toggle('active', btn.textContent.includes('Featured') && featuredOnly));
  renderProducts();
}

function searchProducts() {
  searchQuery = document.getElementById('searchInput').value.toLowerCase();
  renderProducts();
}

function renderProducts() {
  let filtered = [...state.products];
  if (currentCategory !== 'All') filtered = filtered.filter(p => p.category === currentCategory);
  if (currentSubCat !== 'All') filtered = filtered.filter(p => p.subCat === currentSubCat);
  if (currentFilter !== 'All') filtered = filtered.filter(p => p.tag === currentFilter);
  if (featuredOnly) filtered = filtered.filter(p => p.featured);
  if (searchQuery) filtered = filtered.filter(p => p.name.toLowerCase().includes(searchQuery));

  const sort = document.getElementById('sortSelect').value;
  if (sort === 'low-high') filtered.sort((a, b) => a.price - b.price);
  if (sort === 'high-low') filtered.sort((a, b) => b.price - a.price);

  const grid = document.getElementById('productGrid');
  if (!filtered.length) {
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted);">No products found.</div>`;
    return;
  }

  grid.innerHTML = filtered.map(p => `
    <div class="product-card">
      <div class="product-img-wrap" onclick="openProductModal(${p.id})">
        <img src="${(p.coverImage || p.images[0])}">
        ${p.tag ? `<span class="badge-tag badge-${p.tag === 'New' ? 'new' : 'best'}">${p.tag}</span>` : ''}
        ${p.featured ? `<span class="badge-tag badge-feat" style="left:auto;right:60px;">⭐ Featured</span>` : ''}
        <button class="heart-btn" onclick="event.stopPropagation();this.classList.toggle('active');this.textContent=this.classList.contains('active')?'♥':'♡'">♡</button>
      </div>
      <div class="product-info">
        <div class="product-cat">${p.category} ${p.subCat ? '› ' + p.subCat : ''}</div>
        <div class="product-title" onclick="openProductModal(${p.id})">${p.name}</div>
        <div class="product-rating">★★★★★ <span>(${p.rating})</span></div>
        <div class="price-row">
          <span class="price-current">Rs. ${p.price.toLocaleString()}</span>
          ${p.oldPrice ? `<span class="price-old">Rs. ${p.oldPrice.toLocaleString()}</span>` : ''}
        </div>
        <div class="action-btns">
          <button class="btn-add" onclick="addToCart(${p.id})">Add to Cart</button>
          <button class="btn-buy" onclick="buyNow(${p.id})">Buy Now</button>
        </div>
      </div>
    </div>
  `).join('');
}

/* ==========================================
   PRODUCT MODAL
   ========================================== */
let modalProduct = null;
function openProductModal(id) {
  modalProduct = state.products.find(p => p.id === id);
  if (!modalProduct) return;
  document.getElementById('modalMainImg').src = (modalProduct.coverImage || modalProduct.images[0]);
  document.getElementById('modalCat').textContent = modalProduct.category;
  document.getElementById('modalTitle').textContent = modalProduct.name;
  document.getElementById('modalPrice').textContent = `Rs. ${modalProduct.price.toLocaleString()}`;
  document.getElementById('modalDesc').textContent = modalProduct.desc || 'No description available.';
  document.getElementById('productModal').classList.add('show');
}
function closeProductModal() { document.getElementById('productModal').classList.remove('show'); }
function addFromModal() { addToCart(modalProduct.id); closeProductModal(); }
function buyFromModal() { buyNow(modalProduct.id); closeProductModal(); }

/* ==========================================
   CART & CHECKOUT
   ========================================== */
function addToCart(id) {
  const item = state.cart.find(i => i.id === id);
  if (item) item.qty++;
  else state.cart.push({ id, qty: 1 });
  saveData();
  updateCartCount();
  showToast('Added to cart!');
}

function updateCartCount() {
  document.getElementById('cartCount').textContent = state.cart.reduce((s, i) => s + i.qty, 0);
}

function openCartDrawer() {
  renderCartItems();
  document.getElementById('cartDrawer').classList.add('show');
}
function closeCartDrawer() { document.getElementById('cartDrawer').classList.remove('show'); }

function renderCartItems() {
  const c = document.getElementById('cartItems');
  let total = 0;
  if (!state.cart.length) {
    c.innerHTML = `<p style="text-align:center;color:var(--text-muted);margin-top:30px;">Cart is empty.</p>`;
    document.getElementById('cartTotal').textContent = `Rs. 0`;
    return;
  }
  c.innerHTML = state.cart.map(item => {
    const p = state.products.find(x => x.id === item.id);
    if (!p) return '';
    total += p.price * item.qty;
    return `
      <div class="cart-item">
        <img src="${(p.coverImage || p.images[0])}">
        <div class="cart-item-info"><h4>${p.name}</h4><p>Rs. ${p.price} × ${item.qty}</p></div>
        <button onclick="removeFromCart(${p.id})" style="color:#ef4444;font-size:20px;">×</button>
      </div>
    `;
  }).join('');
  document.getElementById('cartTotal').textContent = `Rs. ${total.toLocaleString()}`;
}

function removeFromCart(id) {
  state.cart = state.cart.filter(i => i.id !== id);
  saveData(); updateCartCount(); renderCartItems();
}

function buyNow(id) {
  const p = state.products.find(x => x.id === id);
  if (!p) return;
  const waNumber = state.settings.whatsapp;
  const msg = `*Direct Order*%0AProduct: ${p.name}%0APrice: Rs. ${p.price}%0AQty: 1`;
  window.open(`https://wa.me/${waNumber}?text=${msg}`, '_blank');
}

function openCheckoutModal() {
  if (!state.cart.length) return showToast('Cart is empty!');
  closeCartDrawer();
  document.getElementById('checkoutModal').classList.add('show');
}
function closeCheckoutModal() { document.getElementById('checkoutModal').classList.remove('show'); }

function placeOrder(e) {
  e.preventDefault();
  const total = state.cart.reduce((s, i) => {
    const p = state.products.find(x => x.id === i.id);
    return s + (p ? p.price * i.qty : 0);
  }, 0);

  const order = {
    id: 'ORD' + Date.now(),
    date: new Date().toLocaleString(),
    name: document.getElementById('coName').value,
    phone: document.getElementById('coPhone').value,
    address: document.getElementById('coAddress').value,
    city: document.getElementById('coCity').value,
    notes: document.getElementById('coNotes').value,
    items: state.cart.map(i => {
      const p = state.products.find(x => x.id === i.id);
      return { name: p.name, qty: i.qty, price: p.price };
    }),
    total
  };

  state.orders.unshift(order);
  saveData();

  let msg = `*New Order*%0A*Name:* ${order.name}%0A*Phone:* ${order.phone}%0A*Address:* ${order.address}, ${order.city}%0A*Notes:* ${order.notes}%0A%0A*Items:*%0A`;
  order.items.forEach(i => msg += `• ${i.name} (x${i.qty}) — Rs. ${i.price * i.qty}%0A`);
  msg += `%0A*Total: Rs. ${order.total}*`;

  window.open(`https://wa.me/${state.settings.whatsapp}?text=${msg}`, '_blank');

  state.cart = [];
  saveData();
  updateCartCount();
  closeCheckoutModal();
  showToast('Order placed!');
}

/* ==========================================
   AUTH (Login / Register / Admin)
   ========================================== */
function openAuthModal() {
  document.getElementById('authModal').classList.add('show');
}
function closeAuthModal() {
  document.getElementById('authModal').classList.remove('show');
}
function switchAuthTab(tab) {
  document.getElementById('tabLogin').classList.toggle('active', tab === 'login');
  document.getElementById('tabSignup').classList.toggle('active', tab === 'signup');
  document.getElementById('formLogin').classList.toggle('active', tab === 'login');
  document.getElementById('formSignup').classList.toggle('active', tab === 'signup');
