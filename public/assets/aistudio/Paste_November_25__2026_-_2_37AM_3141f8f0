  el.innerHTML=`<h3>All Orders</h3>${state.orders.map(o=>`<div class="admin-order"><div class="admin-order-head"><b>${ccSafe(o.id)}</b><b>${ccMoney(o.total)}</b></div><small>${ccSafe(o.date||'')}</small><p><b>${ccSafe(o.name)}</b> · ${ccSafe(o.phone)} · ${ccSafe(o.city)}</p><p>${ccSafe(o.address)}</p><p>${(o.items||[]).map(i=>`${ccSafe(i.name)} × ${i.qty}`).join(', ')}</p><label>Status <select class="form-control" onchange="setOrderStatus('${ccSafe(o.id)}',this.value)">${['Pending','Confirmed','Processing','Shipped','Delivered','Cancelled'].map(x=>`<option ${o.status===x?'selected':''}>${x}</option>`).join('')}</select></label></div>`).join('')||'<p>No orders yet.</p>'}`;
 }else if(tab==='customers'){
  el.innerHTML=`<h3>Customers</h3><div class="table-scroll"><table class="admin-table"><tr><th>Name</th><th>Email</th><th>Phone</th></tr>${state.customers.map(c=>`<tr><td>${ccSafe(c.name)}</td><td>${ccSafe(c.email)}</td><td>${ccSafe(c.phone)}</td></tr>`).join('')||'<tr><td colspan="3">No customers yet.</td></tr>'}</table></div>`;
 }
}
function editProduct(id){
 let p=id?state.products.find(x=>Number(x.id)===Number(id)):null;ccEditingId=p?p.id:null;ccAdminImages=[null,null,null,null];ccAdminCover=0;
 if(p){(p.images||[]).slice(0,4).forEach((x,i)=>ccAdminImages[i]=x);ccAdminCover=Math.max(0,(p.images||[]).indexOf(p.coverImage||p.images?.[0]));}
 let cat=p?.category||state.categories[0]?.name||'',sub=state.categories.find(c=>c.name===cat)?.subCats||[];
 document.getElementById('adminContent').innerHTML=`<h3>${p?'Edit':'Add'} Product</h3><form onsubmit="saveProduct(event)">
 <div class="form-row"><div class="form-group"><label>Name</label><input id="epName" class="form-control" required value="${ccSafe(p?.name||'')}"></div><div class="form-group"><label>Price</label><input id="epPrice" type="number" min="1" class="form-control" required value="${p?.price||''}"></div></div>
 <div class="form-row"><div class="form-group"><label>Old price</label><input id="epOld" type="number" class="form-control" value="${p?.oldPrice||''}"></div><div class="form-group"><label>Rating</label><input id="epRating" type="number" min="0" max="5" step=".1" class="form-control" value="${p?.rating||4.8}"></div></div>
 <div class="form-row"><div class="form-group"><label>Category</label><select id="epCat" class="form-control" onchange="updateSubCatSelect(this.value)">${state.categories.map(c=>`<option ${c.name===cat?'selected':''}>${ccSafe(c.name)}</option>`).join('')}</select></div><div class="form-group"><label>Sub-category</label><select id="epSubCat" class="form-control">${sub.map(x=>`<option ${p?.subCat===x?'selected':''}>${ccSafe(x)}</option>`).join('')}</select></div></div>
 <div class="form-row"><div class="form-group"><label>Tag</label><select id="epTag" class="form-control">${['New','Bestseller','Popular','Sale'].map(x=>`<option ${p?.tag===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="form-group"><label>Featured</label><select id="epFeatured" class="form-control"><option value="false" ${p&&!p.featured?'selected':''}>No</option><option value="true" ${p?.featured?'selected':''}>Yes</option></select></div></div>
 <div class="form-group"><label>Description</label><textarea id="epDesc" class="form-control">${ccSafe(p?.desc||'')}</textarea></div><div class="form-group"><label>Buy Now / Affiliate URL (optional)</label><input id="epBuy" type="url" class="form-control" value="${ccSafe(p?.buyLink||'')}"></div>
 <div class="form-group"><label>Images (up to 4) — select ★ for cover</label><input type="file" class="form-control" accept="image/*" multiple onchange="handleProductImages(event)"><div class="admin-image-slots" id="adminImageSlots"></div></div>
 <button class="admin-btn">${p?'Save Changes':'Add Product'}</button><button type="button" class="admin-btn btn-danger" onclick="switchAdminTab('products')">Cancel</button></form>`;
 renderAdminImageSlots();
}
function renderAdminImageSlots(){let w=document.getElementById('adminImageSlots');if(!w)return;w.innerHTML=ccAdminImages.map((x,i)=>`<div class="admin-image-slot">${x?`<img src="${x}"><button type="button" onclick="removeAdminImage(${i})">×</button><button type="button" class="cover ${i===ccAdminCover?'active':''}" onclick="setAdminCover(${i})">★</button>`:`Image ${i+1}`}</div>`).join('');}
function ccResize(file){return new Promise((resolve,reject)=>{let r=new FileReader();r.onerror=reject;r.onload=()=>{let im=new Image();im.onerror=reject;im.onload=()=>{let c=document.createElement('canvas'),scale=Math.min(1000/im.width,1000/im.height,1);c.width=im.width*scale;c.height=im.height*scale;c.getContext('2d').drawImage(im,0,0,c.width,c.height);resolve(c.toDataURL('image/jpeg',.82));};im.src=r.result;};r.readAsDataURL(file);});}
async function handleProductImages(e){for(let f of [...e.target.files].slice(0,4)){let i=ccAdminImages.findIndex(x=>!x);if(i<0)break;try{ccAdminImages[i]=await ccResize(f);if(ccAdminImages.filter(Boolean).length===1)ccAdminCover=i;}catch(_){showToast('Image upload failed');}}renderAdminImageSlots();}
function removeAdminImage(i){ccAdminImages[i]=null;if(ccAdminCover===i)ccAdminCover=Math.max(0,ccAdminImages.findIndex(Boolean));renderAdminImageSlots();}
function setAdminCover(i){if(ccAdminImages[i]){ccAdminCover=i;renderAdminImageSlots();}}
function updateSubCatSelect(cat){let el=document.getElementById('epSubCat');if(el)el.innerHTML=(state.categories.find(c=>c.name===cat)?.subCats||[]).map(x=>`<option>${ccSafe(x)}</option>`).join('');}
function saveProduct(e){
 e.preventDefault();let imgs=ccAdminImages.filter(Boolean);if(!imgs.length)return showToast('Upload at least one image');
 let p={id:ccEditingId||Date.now(),name:document.getElementById('epName').value.trim(),price:Number(document.getElementById('epPrice').value),oldPrice:Number(document.getElementById('epOld').value)||0,rating:Number(document.getElementById('epRating').value)||4.8,category:document.getElementById('epCat').value,subCat:document.getElementById('epSubCat').value,tag:document.getElementById('epTag').value,featured:document.getElementById('epFeatured').value==='true',desc:document.getElementById('epDesc').value.trim(),buyLink:document.getElementById('epBuy').value.trim(),images:[ccAdminImages[ccAdminCover]||imgs[0],...imgs.filter(x=>x!==(ccAdminImages[ccAdminCover]||imgs[0]))],coverImage:ccAdminImages[ccAdminCover]||imgs[0]};
 if(ccEditingId){let i=state.products.findIndex(x=>x.id===ccEditingId);if(i>=0)state.products[i]=p;}else state.products.unshift(p);
 saveData();renderProducts();switchAdminTab('products');showToast('Product saved');
}
function deleteProduct(id){if(!confirm('Delete this product?'))return;state.products=state.products.filter(x=>Number(x.id)!==Number(id));saveData();renderProducts();switchAdminTab('products');}
function toggleFeatured(id){let p=state.products.find(x=>Number(x.id)===Number(id));if(!p)return;p.featured=!p.featured;saveData();renderProducts();switchAdminTab('products');}
function addCategory(e){e.preventDefault();let name=document.getElementById('newCatName').value.trim(),img=document.getElementById('newCatImg').value.trim();if(state.categories.some(c=>c.name.toLowerCase()===name.toLowerCase()))return showToast('Category already exists');state.categories.push({name,img,subCats:[]});saveData();renderCategories();renderNavLinks();switchAdminTab('categories');}
function addSubCategory(e){e.preventDefault();let c=state.categories.find(x=>x.name===document.getElementById('subCatParent').value),n=document.getElementById('newSubCatName').value.trim();if(!c||!n)return;if(!c.subCats.includes(n))c.subCats.push(n);saveData();switchAdminTab('categories');}
function deleteCategory(i){if(!confirm('Delete this category?'))return;state.categories.splice(i,1);saveData();renderCategories();renderNavLinks();switchAdminTab('categories');}
async function uploadLogo(e){let f=e.target.files[0];if(!f)return;try{state.settings.brandIconUrl=await ccResize(f);saveData();applyTheme();let p=document.getElementById('adminLogoPreview');if(p)p.innerHTML=`<img src="${state.settings.brandIconUrl}">`;showToast('Logo uploaded');}catch(_){showToast('Logo upload failed');}}
function removeLogo(){state.settings.brandIconUrl='';saveData();applyTheme();let p=document.getElementById('adminLogoPreview');if(p)p.textContent=state.settings.brandIcon||'C';}
function saveBranding(e){e.preventDefault();let s=state.settings;s.brandName=document.getElementById('setBrand').value.trim();s.brandIcon=document.getElementById('setBrandIcon').value.trim()||'C';s.announcement=document.getElementById('setAnnounce').value.trim();s.primary=document.getElementById('setPrimary').value;s.accent=document.getElementById('setAccent').value;s.font=document.getElementById('setFont').value;s.headFont=document.getElementById('setHeadFont').value;let h=state.heroSlides[0]||{};state.heroSlides[0]={...h,title:document.getElementById('heroTitle').value.trim(),desc:document.getElementById('heroDesc').value.trim(),btn:document.getElementById('heroBtn').value.trim()||'Shop Now',img:document.getElementById('heroImg').value.trim()||h.img};saveData();applyTheme();renderHero();showToast('Store design updated');}
function resetTheme(){if(!confirm('Reset theme colors and fonts?'))return;Object.assign(state.settings,{primary:'#315b45',accent:'#d98b55',font:"'Inter', sans-serif",headFont:"'Playfair Display', serif"});saveData();applyTheme();switchAdminTab('branding');}
function saveWa(e){if(e)e.preventDefault();let n=document.getElementById('setWa').value.replace(/\D/g,'');if(n.length<10)return showToast('Enter a valid WhatsApp number');state.settings.whatsapp=n;saveData();showToast('Settings saved');switchAdminTab('settings');}
function setOrderStatus(id,status){let o=state.orders.find(x=>String(x.id)===String(id));if(!o)return;o.status=status;saveData();showToast('Order status updated');}

ccEnsure();
ccVisit();
</script>

