function handleCustomerLogin(e) {
  e.preventDefault();
  const email = document.getElementById('loginEmail').value;
  const pass = document.getElementById('loginPass').value;
  const cust = state.customers.find(c => c.email === email && c.pass === pass);

  if (cust) {
